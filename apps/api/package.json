{
  "name": "api",
  "version": "0.0.0",
  "description": "Authentication template",
  "author": "Griego Code <griegocode@proton.me>",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "biome format --write .",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@core/config": "workspace:*",
    "@core/database": "workspace:*",
    "@core/domain": "workspace:*",
    "@core/shared-server": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/multipart": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "argon2": "catalog:",
    "bullmq": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "date-fns": "catalog:",
    "fastify": "catalog:",
    "handlebars": "catalog:",
    "ioredis": "catalog:",
    "joi": "catalog:",
    "nanoid": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "qrcode": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "speakeasy": "catalog:",
    "typeorm": "catalog:",
    "uuid": "catalog:",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:"
  },
  "devDependencies": {
    "@configs/typescript": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/handlebars": "catalog:",
    "@types/ioredis": "catalog:",
    "@types/jest": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/speakeasy": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "pg-mem": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
