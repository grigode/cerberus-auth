{
  "name": "cerberus-auth",
  "version": "0.0.0",
  "author": "Griego Code <griegocode@proton.me>",
  "license": "MIT",
  "description": "Authentication template",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean",
    "db:migration:run": "pnpm --filter @core/database migration:run",
    "db:migration:revert": "pnpm --filter @core/database migration:revert",
    "db:migration:generate": "pnpm --filter @core/database migration:generate",
    "db:migration:create": "pnpm --filter @core/database migration:create",
    "db:seed": "pnpm --filter @core/database seed",
    "prepare": "git config core.hooksPath .githooks"
  },
  "engines": {
    "name": "pnpm",
    "version": "11.18.0",
    "onFail": "download"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
