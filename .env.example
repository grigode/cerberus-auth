############################
# Application Configuration
############################

# Application name used for logs, monitoring, emails, and internal identification.
APP_NAME=Arachne

# Port where the HTTP/HTTPS server will listen.
# Must be a valid TCP port (1–65535).
PORT=8000

# Enables HTTPS support for the HTTP server.
# When set to true, the application will start using HTTPS.
# When false, the server will run over plain HTTP.
IS_HTTPS=false

# Frontend
FRONTEND_URL=http://localhost:3000

# Log verbosity level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Directory where daily rotated log files will be saved
LOG_DIR=logs

# Enables writing logs to files (application-YYYY-MM-DD.log & error-YYYY-MM-DD.log)
LOG_TO_FILE=true


############################
# Database Configuration
############################

# Main database host.
# Use "localhost" for local development or a hostname/IP in production.
MAIN_DATABASE_HOST=localhost

# Database port.
# Common values:
# - 5432 for PostgreSQL
# - 3306 for MySQL / MariaDB
MAIN_DATABASE_PORT=5432

# Database user with read/write permissions.
MAIN_DATABASE_USERNAME=postgres

# Database user password.
MAIN_DATABASE_PASSWORD=password

# Database name used by the application.
MAIN_DATABASE_NAME=arachne

# Enables automatic schema synchronization.
# WARNING: Do NOT enable in production.
# Accepted values: true | false
MAIN_DATABASE_SYNCHRONIZE=true

# Database timezone used for connections.
# Example: +00:00 (UTC)
MAIN_DATABASE_TIMEZONE=+00:00


############################
# Mail / SMTP Configuration
############################
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=Arachne
SMTP_FROM_EMAIL=no-reply@arachne.com


############################
# Redis Configuration
############################
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


############################
# Security Configuration
############################

# Enables Content Security Policy (CSP) headers.
# Recommended: true in production.
CONTENT_SECURITY_POLICY=false

# Secret key used for signing and encrypting cookies.
# Must be a long, random, and private value in production.
COOKIE_KEY=cookie_key

# Allowed CORS origins.
# Comma-separated list of URLs.
# Example: http://localhost:3000,https://myapp.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Allows cookies and authorization headers in CORS requests.
# Accepted values: true | false
CORS_CREDENTIALS=false

# Allowed HTTP methods for CORS.
# Use "*" to allow all methods or specify a comma-separated list.
# Example: GET,POST,PUT,DELETE
CORS_METHODS=*

# JWT key
JWT_SECRET=jwt_access_token_secret

# Symmetric Encryption Key (AES-256-GCM)
ENCRYPTION_KEY=encryption_key_secret_32_bytes_long

# Google OAuth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/iam/google/callback
GOOGLE_REDIRECT_FRONTEND_URL=http://localhost:3000

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_EMAIL_TTL=60000
THROTTLE_EMAIL_LIMIT=2


############################
# Storage Configuration (S3 / MinIO)
############################
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=arachne-uploads
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_URL_EXPIRATION_SECONDS=3600
STORAGE_S3_PUBLIC_URL=
